# Server-only OpenRouter credential. Never prefix this variable with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Server-only daily source reservations per user. Must be between 1 and 100.
INGESTION_DAILY_LIMIT=5

# Safe browser credentials supplied by the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
